    {
      "parameters": {
        "jsCode": "const d = $json.body ?? $json;\nconst score = Number(d.score || 0);\nconst valid = Boolean(d.player && d.brawler && Number.isFinite(score));\nlet rank = 'ROOKIE';\nif (score >= 3000) rank = 'ARENA LEGEND'; else if (score >= 2000) rank = 'NEON ELITE'; else if (score >= 1000) rank = 'BRAWLER'; else if (score >= 500) rank = 'FIGHTER';\nreturn [{ json: { ...d, score, valid, rank, bonusXp: Math.max(25, Math.round(score / 12)), achievement: score >= 2000 ? 'Arena Dominator' : 'Arena Fighter' } }];"
      },
